# HistoryBot environment template
# Copy to .env and fill in locally. Never commit real secrets.
# Do not invent API keys or passwords.

# --- Application ---
NODE_ENV=development
APP_NAME=HistoryBot
APP_PORT=3000
PUBLIC_APP_URL=

# --- Database (MySQL) ---
# Local development. Do not put real passwords in this file.
# MYSQL_DATABASE must be historybot (not Odoo/Infomax schemas).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=historybot
DATABASE_URL=

# --- LLM adapter (OpenAI-compatible HTTP) ---
# Development: typically Ollama's OpenAI-compatible endpoint.
# Production provider is NOT locked. Set at deploy time.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings ---
EMBEDDING_MODEL=nomic-embed-text

# --- Ollama (local development) ---
OLLAMA_HOST=http://127.0.0.1:11434

# --- Python RAG internal service ---
RAG_INTERNAL_URL=http://127.0.0.1:8000
INTERNAL_RAG_SECRET=

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
DAILY_LLM_BUDGET=

# --- PDF ---
PDF_FONT_DIR=data/fonts
PDF_OUTPUT_DIR=data/generated
