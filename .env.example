# HistoryBot environment template
# Copy to .env and fill in locally. Never commit real secrets.
# Do not invent API keys or passwords.

# --- Application ---
NODE_ENV=development
APP_NAME=HistoryBot
APP_PORT=3000
PORT=3000
PUBLIC_APP_URL=

# --- Database (MySQL) ---
# Local development. Do not put real passwords in this file.
# MYSQL_DATABASE must be historybot (not Odoo/Infomax schemas).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=historybot
DATABASE_URL=

# --- LLM adapter ---
# Phase 6 local development uses Ollama. Production provider is not locked.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama3
# OpenAI Responses API. Leave the key blank here. Ollama is used when this key is empty or the call fails.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_BASE_URL=https://api.openai.com

# --- Embeddings ---
EMBEDDING_MODEL=nomic-embed-text

# --- Ollama ---
OLLAMA_HOST=http://127.0.0.1:11434

# --- RAG (starting values from Phase 5 retrieval tests; not a guarantee) ---
RAG_TOP_K=5
RAG_DISTANCE_THRESHOLD=0.55


# --- Python RAG internal service (bind 127.0.0.1 only) ---
RAG_INTERNAL_URL=http://127.0.0.1:8000
RAG_INTERNAL_PORT=8000
RAG_TIMEOUT_MS=180000
RAG_ECONTENT_TIMEOUT_MS=900000
INTERNAL_RAG_SECRET=

# --- Frontend (public; no secrets) ---
# Copy to frontend/.env for Vite. Do not put API keys here.
# VITE_API_BASE_URL=http://127.0.0.1:3000

# --- CORS ---
# Browser origins allowed to call this API. Keep every existing origin.
# Local Vite may use 5173 or 5176. Add the Netlify origin in production
# without removing the local origins.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176


# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
DAILY_LLM_BUDGET=
# Per-account AI limits for chat answers and learning modules (optional).
# Each signed-in student or teacher gets AI_BURST_LIMIT requests per
# AI_BURST_WINDOW_MIN minutes and AI_DAILY_LIMIT requests per 24 hours.
# Defaults are shown. Counters are kept in memory and reset when the API restarts.
# AI_BURST_LIMIT=20
# AI_BURST_WINDOW_MIN=10
# AI_DAILY_LIMIT=200

# --- PDF ---
PDF_FONT_DIR=data/fonts
PDF_OUTPUT_DIR=data/generated
